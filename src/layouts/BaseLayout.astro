---
import Head from '@/components/Head.astro'
import LeftSidebar from '@/components/LeftSidebar.astro'
import StickerGallery from '@/components/Widgets/StickerGallery.astro'
import TopBar from '@/components/TopBar.astro'
interface Props {
    title: string
    description: string
    slug?: string
}
const { title, description, slug = '' } = Astro.props
---

<!doctype html>
<html lang="en">
    <Head
        title={title}
        description={description
            ? `${description} | Adithya Nair's Website`
            : "Adithya Nair's Website"}
        slug={slug}
    />
    <TopBar />
    <main>
        <LeftSidebar />
        <div class="content">
            <slot />
        </div>
        <div><StickerGallery /></div>
    </main>
</html>
