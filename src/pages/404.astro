---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="Error 404" description="This page doesn't seem to exist.">
    <div class="error-wrapper">
        <h1 class="error-code">404</h1>
        <p class="error-msg">This page is a 404 page. Sorry, you clicked the wrong link somehow.</p>
        <a href="/" class="error-link">[home]</a>
    </div>
</BaseLayout>

<style>
    .error-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 55vh;
        text-align: center;
        font-family: var(--font-sans);
    }

    .error-code {
        font-size: clamp(4rem, 20vw, 8rem);
        font-weight: 800;
        font-family: var(--font-mono);
        color: var(--accent);
        line-height: 1;
        margin: 0;
        letter-spacing: -0.03em;
    }

    .error-msg {
        font-size: var(--size-xl);
        color: var(--gray);
        margin: 1.5em 0 2.5em 0;
        line-height: 1.5;
        font-family: var(--font-mono);
    }

    .error-link {
        font-size: var(--size-base);
        color: var(--accent);
        text-decoration: none;
        padding: 0.5em 1em;
        border: 1px solid var(--accent);
        transition: background 0.15s ease;
        font-family: var(--font-mono);
    }

    .error-link:hover {
        background: color-mix(in oklch, var(--accent) 15%, transparent);
    }

    @media (max-width: 600px) {
        .error-code {
            font-size: clamp(3rem, 25vw, 5rem);
        }

        .error-msg {
            font-size: var(--size-base);
        }
    }
</style>
