---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BlogCard from '@/components/BlogCard.astro'
import RecentlyUpdated from '@/components/Widgets/RecentlyUpdated.astro'

import { getCollection } from 'astro:content'

const blogPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

const mostRecentPosts = blogPosts
    .filter((entry) => !entry.data.isDraft)
    .slice(0, 3)
---

<BaseLayout title="Adithya Nair" description="Welcome to my website">
    <h1>Hello, I'm Adithya.</h1>
    <p>Welcome to my home on the Internet.</p>

    <h2>Latest Posts</h2>
    {
        mostRecentPosts.map((entry) => (
            <BlogCard
                title={entry.data.title}
                description={entry.data.description}
                link={`/blog/${entry.id}`}
                date={entry.data.date}
            />
        ))
    }

    <h2>Recently Updated</h2>
    <RecentlyUpdated />
</BaseLayout>