---
import Home from '@/components/NavIcons/Home.svg'
import FormattedDate from '@/components/FormattedDate.astro'
const currentPath = Astro.url.pathname
const links = [
    { label: 'blog', href: '/blog' },
    { label: 'reviews', href: '/reviews' },
    { label: 'garden', href: '/garden' },
    { label: 'about', href: '/about' },
    { label: 'rss', href: '/rss.xml' },
]

let currentDate = new Date(Date.now())

const isCurrent = (href: string) =>
    href === '/' ? currentPath === '/' : currentPath.startsWith(href)
---

<header class="topbar">
    <a href="/" class="home-icon" aria-label="Go to homepage"
        ><Home aria-hidden="true" /> <span>Home</span></a
    >

    <div class="site-title" aria-label="Site name">
        <p>Adithya Nair</p>
        <nav>
            <ul>
                {
                    links.map((link) => (
                        <li>
                            <a
                                aria-current={
                                    isCurrent(link.href) ? 'page' : undefined
                                }
                                href={link.href}
                            >
                                <span>{link.label}</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>

    <div class="metadata" role="group" aria-label="Page info">
        <span>Blogging Since: <FormattedDate date="2024-10-13" /> </span>
        <span>Last Updated: <FormattedDate date={currentDate} /> </span>
    </div>
</header>

<style>
    .topbar {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        width: 100%;
    }

    .topbar > * + * {
        border-left: none;
    }

    .topbar > .site-title {
        font-size: var(--size-4xl);
        font-weight: bold;
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
    }

    .site-title > p {
        margin: 0;
        align-self: stretch;
        padding: 0.2em 0 0.3em;
        font-family: var(--font-mono);
        border-bottom: 4px double var(--rule);
    }

    nav ul {
        margin: 0;
        list-style: none;
        padding: 0.55em 0 0.35em;
        display: flex;
        gap: 0.8em;
        font-size: var(--size-xl);
    }

    nav ul a::before {
        content: '[';
    }

    nav ul a::after {
        content: ']';
    }

    nav ul a {
        display: inline-flex;
        align-items: baseline;
    }

    nav ul a[aria-current='page'] {
        color: var(--accent);
    }

    .topbar > .metadata {
        display: flex;
        align-items: flex-start;
        justify-items: left;
        flex-direction: column;
        gap: 0.65em;
        font-size: var(--size-xs);
        color: var(--gray);
    }

    .topbar > * {
        border: 1px solid var(--rule);
        padding: 0.45rem 0.8rem;
        margin: 0;
        display: flex;
        align-items: center;
        align-self: stretch;
        height: 100%;
        justify-content: center;
    }

    .home-icon {
        flex-direction: column;
        gap: 0.2em;
    }

    .home-icon svg {
        width: 64px;
        height: auto;
    }

    @media (max-width: 960px) {
        .topbar {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto;
        }

        .topbar > .metadata {
            display: none;
        }

        .topbar > * {
            padding: 0.4rem 0.6rem;
        }

        .topbar > .site-title {
            font-size: var(--size-2xl);
        }

        .home-icon {
            flex-direction: row;
            gap: 0.5em;
        }

        .home-icon svg {
            width: 28px;
        }

        .home-icon span {
            font-family: var(--font-mono);
            font-size: var(--size-base);
            font-weight: 700;
        }

        nav ul {
            padding: 0.4em 0;
            gap: 0.8em;
            font-size: var(--size-base);
            flex-wrap: wrap;
        }
    }
</style>
