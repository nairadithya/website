---
import { GET } from '@/pages/api/latest-review.json.ts'
const response = await GET()
const data = response.ok ? await response.json() : null
import Film from '@/icons/film.svg'
---

<div class="card">
    <div>
        <h2>Latest Review</h2>
        {
            data ? (
                <>
                    <a href={data.link}><span>{data.film}</span></a><br />
                    <span class="rating">{data.stars}</span>
                </>
            ) : (
                <span>No data available</span>
            )
        }
    </div>
    <Film />
</div>

<style>
    .card {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .card svg {
        width: 4em;
    }

    .rating {
        color: var(--secondary);
    }
</style>
