---
let links = [
    { url: 'https://github.com/nairadithya', icon: 'GitHub' },
    { url: 'https://letterboxd.com/nairadithya', icon: 'LetterBoxd' },
    { url: 'https://linkedin.com/in/nairadithya', icon: 'LinkedIn' },
    { url: 'https://x.com/nairad1thya', icon: 'X (The Bird Site)' },
    { url: 'https://discord.com/app', icon: 'Discord (@nairadithya)' },
]

import ArrowRight from '@/icons/arrow-right.svg'
---

<div class="quicklinks card">
    <h2>Find Me Elsewhere</h2>
    <div class="quicklinks-list">
        {
            links.map((link) => (
                <div class="link">
                    <ArrowRight aria-hidden="true" />
                    <a href={link.url}>{link.icon}</a>
                </div>
            ))
        }
    </div>
</div>

<style>
    .quicklinks-list {
        margin-top: 0.5em;
    }

    .link {
        display: flex;
        align-items: center;
        gap: 0.3em;
    }
    .link svg {
        color: var(--accent);
        width: var(--size-xl);
        height: auto;
    }
</style>
