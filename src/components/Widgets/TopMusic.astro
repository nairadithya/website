---
import { GET } from '@/pages/api/top-song.json.ts'
let response = await GET()
let data = response.ok ? await response.json() : null
import Music from '@/icons/music.svg'
---

<div class="card">
    <div>
        <h2>Top Song</h2>
        {
            data ? (
                <>
                    <a href={data.toptracks?.track?.[0]?.url}>
                        <span>{data.toptracks?.track?.[0]?.name}</span>
                    </a>
                    <br />
                    <span>{data.toptracks?.track?.[0]?.artist?.name}</span>
                </>
            ) : (
                <span>No data available</span>
            )
        }
    </div>
    <Music />
</div>

<style>
    .card {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }

    .card svg {
        width: 4em;
    }
</style>
