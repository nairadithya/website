---
const badges = [
    {
        src: '/badges/at.gif',
        alt: 'Amrita.town',
        href: 'https://amrita.town',
    },
    {
        src: '/badges/atlasbutton.png',
        alt: 'Atlas Dev Club',
        href: 'https://atlasdev.club',
    },
    {
        src: '/badges/thread-locked.gif',
        alt: 'ThreadLocked',
        href: 'https://threadlocked.xyz/',
    },
    {
        src: '/badges/dark-mode.gif',
        alt: 'Made for Dark Mode',
        href: 'https://www.youtube.com/watch?v=bOwsLtwa2Ts',
    },
    {
        src: '/badges/hl.gif',
        alt: 'Half-Life',
        href: 'https://youtu.be/2Whsld94IHQ',
    },
    {
        src: '/badges/emacsemacsemacs.gif',
        alt: 'GNU Emacs',
        href: 'https://youtu.be/urcL86UpqZc',
    },
]
---

<div class="card">
    <h2>Badges</h2>
    <div class="sticker-gallery">
        {
            badges.map((badge) => (
                <a href={badge.href}>
                    <img
                        src={badge.src}
                        alt={badge.alt}
                        loading="lazy"
                        width="88"
                        height="31"
                    />
                </a>
            ))
        }
    </div>
</div>

<style>
    .card {
        gap: 1em;
    }

    .sticker-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(88px, 100%), 1fr));
        gap: 0.5em;
        justify-items: center;
        width: 100%;
    }

    .sticker-gallery a {
        display: flex;
        justify-content: center;
        min-width: 0;
    }

    .sticker-gallery img {
        display: block;
        width: 88px;
        max-width: 100%;
        height: auto;
    }
</style>
