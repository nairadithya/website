---
import Location from '@/icons/location.svg'
---

<div class="card">
    <div>
        <h2>Location</h2>
        <div>Bangalore, India</div>
    </div>
    <Location />
</div>

<style>
    .card svg {
        width: 4em;
        height: auto;
    }

    h2 {
        margin: 0;
    }

    .card {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
</style>
