---
const { title, description, link, date } = Astro.props
import FormattedDate from '@/components/FormattedDate.astro'
---

<div>
    <a href={link}>
        <div>
            <h2>
                {title}<br />
                <FormattedDate date={date} />
            </h2>
        </div>
    </a>
</div>
