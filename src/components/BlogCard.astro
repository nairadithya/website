---
interface Props {
    title: string
    description?: string
    link: string
    date: Date
}
const { title, description, link, date } = Astro.props
import FormattedDate from '@/components/FormattedDate.astro'
---

<a class="blog-card" href={link}>
    <div class="blog-card-row">
        <h2>{title}</h2>
        <span class="dot-leader" aria-hidden="true"></span>
        <time><FormattedDate date={date} /></time>
    </div>
    {description && <p>{description}</p>}
</a>

<style>
    .blog-card {
        display: block;
        text-decoration: none;
        color: var(--foreground);
        padding: 0.8em 0;
        transition: background 0.1s ease;
    }

    .blog-card:hover {
        background: color-mix(in oklch, var(--accent) 10%, transparent);
    }

    .blog-card-row {
        display: flex;
        align-items: baseline;
        gap: 0.5em;
    }

    .blog-card h2 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: var(--size-xl);
        font-weight: 600;
        line-height: 1.3;
        color: var(--accent);
        flex-shrink: 0;
    }

    .dot-leader {
        flex: 1;
        min-width: 0.5em;
        border-bottom: 1px dotted var(--foreground);
        align-self: center;
    }

    .blog-card time {
        font-family: var(--font-mono);
        font-size: var(--size-xs);
        color: var(--gray);
        flex-shrink: 0;
    }

    .blog-card p {
        margin: 0.3em 0 0 0;
        font-size: var(--size-base);
        font-family: var(--font-serif);
        color: var(--gray);
        line-height: 1.4;
    }

    /* Mobile: stack vertically, no dotted leader */
    @media (max-width: 880px) {
        .blog-card-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0;
        }

        .dot-leader {
            display: none;
        }

        .blog-card h2 {
            font-size: var(--size-base);
        }

        .blog-card time {
            margin-top: 0.3em;
        }

        .blog-card p {
            font-size: var(--size-xs);
        }
    }
</style>