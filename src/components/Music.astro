---
import { GET } from '@/pages/api/top-song.json.ts'
let response = await GET()
const data = await response.json()
import MusicIcon from '@/icons/music.svg'
const fetchedTrack = {
    link: data?.toptracks?.track[0]?.url,
    name: data?.toptracks?.track[0]?.name,
    artist: data?.toptracks?.track[0]?.artist.name,
}
---

{
    fetchedTrack && (
        <a href={fetchedTrack.link} class="">
            <div>
                <div>
                    <MusicIcon aria-hidden="true" />
                </div>
                <div>
                    <div>{fetchedTrack.name}</div>
                    <div>{fetchedTrack.artist}</div>
                </div>
            </div>
        </a>
    )
}
